{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cartas: iniciar API (puerto 8080)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cartas.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Cartas: demo regla 24 dic (puerto 8081, fecha 2026-12-25)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cartas.py",
      "args": ["--puerto", "8081", "--fecha-fija", "2026-12-25"],
      "console": "integratedTerminal"
    },
    {
      "name": "Cartas: correr pruebas",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
